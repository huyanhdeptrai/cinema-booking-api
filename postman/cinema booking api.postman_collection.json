                "exec": [
                  "pm.test(\"Login Customer thành công và lưu token\", function () {\r\n    pm.response.to.have.status(200);\r\n\r\n    const data = pm.response.json();\r\n    pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty;\r\n    pm.expect(data.user.role).to.eql(\"CUSTOMER\");\r\n\r\n    pm.collectionVariables.set(\"customerToken\", data.accessToken);\r\n});"
                ]
